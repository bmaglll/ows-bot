# NOTE: most settings now live in config.toml (technicians, recalls, approval
# codes, timeouts, …). Values here override config.toml / config.local.toml.

# ── Technician / Dealer Identifiers ──────────────────────────────────────────
# Your STARS technician ID — filled into ServiceTechnicianID fields (LAB0019 fix).
# Prefer setting technicians in config.toml; this env var overrides it if set.
#STARS_ID=your_stars_id_here

# ── AI-assisted fixes (optional) ──────────────────────────────────────────────
# Used only for condition-code / part inference fallbacks. Pick the provider in
# config.toml → [ai]; set the matching API key here. Only the one you use is
# needed (Ollama needs none).
ANTHROPIC_API_KEY=sk-ant-...
#OPENAI_API_KEY=sk-...
#GEMINI_API_KEY=...            # or GOOGLE_API_KEY

# Optional env overrides for the [ai] config (handy for quick switching):
#AI_PROVIDER=openai            # anthropic | openai | gemini | ollama | none
#AI_MODEL=gpt-4o-mini
#AI_BASE_URL=http://localhost:11434/v1

# ── Connection ────────────────────────────────────────────────────────────────
# Chrome DevTools Protocol URL (default: http://127.0.0.1:9222)
# CDP_URL=http://127.0.0.1:9222
