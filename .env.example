# NOTE: most settings now live in config.toml (technicians, recalls, approval
# codes, timeouts, …). Values here override config.toml / config.local.toml.

# ── Technician / Dealer Identifiers ──────────────────────────────────────────
# Your STARS technician ID — filled into ServiceTechnicianID fields (LAB0019 fix).
# Prefer setting technicians in config.toml; this env var overrides it if set.
#STARS_ID=your_stars_id_here

# ── Anthropic API (optional) ──────────────────────────────────────────────────
# Required only for AI-assisted condition code / part inference
ANTHROPIC_API_KEY=sk-ant-...

# Claude model used for AI-assisted fixes (default shown below)
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── Connection ────────────────────────────────────────────────────────────────
# Chrome DevTools Protocol URL (default: http://127.0.0.1:9222)
# CDP_URL=http://127.0.0.1:9222
